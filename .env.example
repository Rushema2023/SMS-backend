# Copy this file to .env and fill in real values. Never commit .env itself.

# Postgres connection string Prisma will use.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stock_management?schema=public"

# Port the Express server listens on
PORT=4000

# Secret used to sign/verify JWTs. Use a long random string in real deployments.
JWT_SECRET="replace-this-with-a-long-random-string"

# How long an access token stays valid
JWT_EXPIRES_IN="1d"
